{
  "name": "hyper-sdk-js",
  "version": "3.0.0",
  "description": "TypeScript/JavaScript SDK for bypassing bot protection (Akamai Bot Manager, DataDome, Incapsula, Kasada) via the Hyper Solutions API. Generate sensor data, tokens, and cookies without headless browsers.",
  "type": "module",
  "main": "index.js",
  "homepage": "https://hypersolutions.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyper-Solutions/hyper-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/Hyper-Solutions/hyper-sdk-js/issues"
  },
  "exports": {
    ".": "./index.js",
    "./akamai": "./akamai/index.js",
    "./akamai/*": "./akamai/*.js",
    "./datadome": "./datadome/index.js",
    "./datadome/*": "./datadome/*.js",
    "./incapsula": "./incapsula/index.js",
    "./incapsula/*": "./incapsula/*.js",
    "./kasada": "./kasada/index.js",
    "./kasada/*": "./kasada/*.js",
    "./shared": "./shared/index.js",
    "./shared/*": "./shared/*.js"
  },
  "scripts": {
    "test": "jest",
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "akamai",
    "datadome",
    "incapsula",
    "kasada",
    "bot-protection",
    "bypass",
    "anti-bot",
    "sensor-data",
    "web-scraping",
    "automation"
  ],
  "author": "Hyper Solutions",
  "license": "MIT",
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "typescript": "^5.4.4",
    "undici": "^7.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/preset-typescript": "^7.23.3",
    "@types/jest": "^29.5.11",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  }
}